{
  "name": "moyarich-console-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/console-core",
    "packages/console",
    "packages/*",
    "packages/addons/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:package": "npm run build:core && npm run build --workspace @moyarich/console",
    "build:playground": "npm run build --workspace @moyarich/console-playground",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run format:check && npm run lint && npm run typecheck",
    "hooks:install": "git config core.hooksPath .githooks",
    "build:addons": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace @moyarich/console-core",
    "build:packages": "npm run build --workspaces --if-present",
    "pack:packages": "npm run build:packages && node scripts/run-addon-workspaces.mjs pack && npm pack --workspace @moyarich/console-core --dry-run && npm pack --workspace @moyarich/console --dry-run",
    "test:browser": "playwright test",
    "build:pages": "node scripts/build-pages.mjs",
    "dev:playground": "npm run dev --workspace @moyarich/console-playground",
    "test:storybook": "playwright test --config playwright.storybook.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@^37.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,mdx,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "description": "Workspace for @moyarich/console, a React console and ANSI process-output UI for embedded developer tools.",
  "keywords": [
    "react",
    "console",
    "console-ui",
    "developer-tools",
    "devtools",
    "ansi",
    "stdout",
    "stderr",
    "log-viewer",
    "code-playground",
    "code-runner",
    "iframe",
    "websocket",
    "typescript"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
