{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@moyarich/console": [
        "./packages/console/src/index.ts"
      ],
      "@moyarich/console-core": [
        "./packages/console-core/src/index.ts"
      ],
      "@moyarich/console/*": [
        "./packages/console/src/*"
      ],
      "@src/*": [
        "./apps/playground/src/*"
      ]
    },
    "customConditions": [
      "development"
    ]
  },
  "include": [
    "tests",
    "stories",
    ".storybook",
    "packages/addons/imperative-scrolling/src",
    "packages/addons/annotations/src",
    "packages/addons/animation/src",
    "packages/addons/data-export/src",
    "packages/addons/diagnostics/src",
    "packages/addons/filtering/src",
    "packages/addons/markdown/src",
    "packages/addons/navigation/src",
    "packages/addons/selection/src",
    "packages/addons/resizable/src",
    "packages/console-core/src"
  ]
}
