{
  "name": "@moyarich/console",
  "version": "0.2.0",
  "description": "React console and ANSI process-output UI with capture, object inspection, serialization, and iframe/WebSocket transports.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/styles.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./src/styles.css",
    "./utils/console": {
      "import": {
        "types": "./dist/utils/console/index.d.ts",
        "default": "./dist/utils/console/index.js"
      },
      "require": {
        "types": "./dist/utils/console/index.d.cts",
        "default": "./dist/utils/console/index.cjs"
      }
    },
    "./utils/terminal": {
      "import": {
        "types": "./dist/utils/terminal/index.d.ts",
        "default": "./dist/utils/terminal/index.js"
      },
      "require": {
        "types": "./dist/utils/terminal/index.d.cts",
        "default": "./dist/utils/terminal/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.utils-console.config.ts && vite build --config vite.utils-terminal.config.ts && tsc -p tsconfig.build.json && node ../../scripts/prepare-cjs-types.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "postpack": "node -e \"require('node:fs').rmSync('README.md', { force: true })\""
  },
  "dependencies": {
    "@moyarich/console-core": "0.2.0",
    "anser": "^2.3.5",
    "lucide-react": "^1.47.0",
    "eventemitter3": "^5.0.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git",
    "directory": "packages/console"
  },
  "bugs": {
    "url": "https://github.com/moyarich/console/issues"
  },
  "homepage": "https://github.com/moyarich/console#readme",
  "keywords": [
    "react",
    "console",
    "react-console",
    "console-ui",
    "browser-console",
    "developer-tools",
    "devtools",
    "ansi",
    "stdout",
    "stderr",
    "log-viewer",
    "console-capture",
    "logging",
    "code-playground",
    "code-runner",
    "sandbox",
    "iframe",
    "postmessage",
    "websocket",
    "serialization",
    "typescript"
  ],
  "publisher": "moyarich",
  "author": "Moya Richards",
  "engines": {
    "node": ">=24"
  },
  "typesVersions": {
    "*": {
      "utils/console": [
        "dist/utils/console/index.d.ts"
      ],
      "utils/terminal": [
        "dist/utils/terminal/index.d.ts"
      ]
    }
  }
}
