{
  "name": "@moyarich/console",
  "version": "0.1.0",
  "description": "React console and ANSI process-output UI with capture, object inspection, serialization, and iframe/WebSocket transports.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css",
    "./utils/console": {
      "types": "./dist/utils/console/index.d.ts",
      "import": "./dist/utils/console/index.js",
      "require": "./dist/utils/console/index.cjs"
    },
    "./utils/terminal": {
      "types": "./dist/utils/terminal/index.d.ts",
      "import": "./dist/utils/terminal/index.js",
      "require": "./dist/utils/terminal/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts src/utils/console/index.ts src/utils/terminal/index.ts --format esm,cjs --dts --clean --external react --external react-dom",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "postpack": "node -e \"require('node:fs').rmSync('README.md', { force: true })\""
  },
  "dependencies": {
    "anser": "^2.3.5",
    "lucide-react": "^1.47.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git",
    "directory": "packages/console"
  },
  "bugs": {
    "url": "https://github.com/moyarich/console/issues"
  },
  "homepage": "https://github.com/moyarich/console#readme",
  "keywords": [
    "react",
    "console",
    "react-console",
    "console-ui",
    "browser-console",
    "developer-tools",
    "devtools",
    "ansi",
    "stdout",
    "stderr",
    "log-viewer",
    "console-capture",
    "logging",
    "code-playground",
    "code-runner",
    "sandbox",
    "iframe",
    "postmessage",
    "websocket",
    "serialization",
    "typescript"
  ]
}
