{
  "name": "@moyarich/console-addon-diagnostics",
  "version": "0.1.0",
  "description": "First-party console pipeline diagnostics addon for @moyarich/console.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external @moyarich/console",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@moyarich/console": "^0.1.0"
  },
  "devDependencies": {
    "@moyarich/console": "0.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git",
    "directory": "packages/console-addon-diagnostics"
  },
  "bugs": {
    "url": "https://github.com/moyarich/console/issues"
  },
  "homepage": "https://github.com/moyarich/console#readme",
  "keywords": ["react", "console", "addon", "diagnostics", "debugging", "developer-tools"]
}
