  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git",
    "directory": "packages/addons/links"
  },
  "bugs": {
    "url": "https://github.com/moyarich/console/issues/35"
  },
  "homepage": "https://github.com/moyarich/console#readme",
