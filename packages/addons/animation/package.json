{
  "name": "@moyarich/console-addon-animation",
  "version": "0.1.0",
  "description": "Opt-in entry animations for structured console and terminal output.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
