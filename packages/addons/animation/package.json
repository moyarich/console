  },
  "peerDependencies": {
    "@moyarich/console-core": "^0.1.0",
    "react": ">=18",
    "motion": "^12.0.0"
  },
  "devDependencies": {
    "@moyarich/console-core": "0.1.0",
    "@types/react": "^19.1.12",
    "react": "^19.2.7",
    "motion": "^12.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git",
    "directory": "packages/addons/animation"
  },
  "bugs": {
    "url": "https://github.com/moyarich/console/issues"
  },
  "homepage": "https://github.com/moyarich/console#readme",
