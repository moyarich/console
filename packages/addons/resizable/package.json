{
  "name": "@moyarich/console-addon-resizable",
  "version": "0.2.0",
  "description": "First-party resizable frame addon for @moyarich/console hosts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../../scripts/prepare-cjs-types.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.47.0"
  },
  "peerDependencies": {
    "@moyarich/console-core": "^0.2.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@moyarich/console-core": "0.2.0",
    "@types/react": "^19.1.12",
    "react": "^19.2.7",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git",
    "directory": "packages/addons/resizable"
  },
  "bugs": {
    "url": "https://github.com/moyarich/console/issues"
  },
  "homepage": "https://github.com/moyarich/console#readme",
  "keywords": [
    "console",
    "addon",
    "resize",
    "developer-tools"
  ],
  "sideEffects": [
    "./src/index.tsx",
    "./src/components/ResizableConsoleFrame/ResizableConsoleFrame.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "publisher": "moyarich",
  "author": "Moya Richards",
  "engines": {
    "node": ">=24"
  },
  "private": false
}
