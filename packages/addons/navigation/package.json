{
  "name": "@moyarich/console-addon-navigation",
  "version": "0.2.0",
  "description": "First-party stable-ID message navigation for @moyarich/console hosts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../../scripts/prepare-cjs-types.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@moyarich/console-core": "^0.2.0"
  },
  "devDependencies": {
    "@moyarich/console-core": "0.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git",
    "directory": "packages/addons/navigation"
  },
  "bugs": {
    "url": "https://github.com/moyarich/console/issues"
  },
  "homepage": "https://github.com/moyarich/console#readme",
  "keywords": [
    "console",
    "addon",
    "navigation",
    "errors",
    "warnings",
    "developer-tools"
  ],
  "publisher": "moyarich",
  "author": "Moya Richards",
  "engines": {
    "node": ">=24"
  },
  "private": false
}
