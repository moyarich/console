{
  "name": "@moyarich/console-addon-search",
  "version": "0.1.0",
  "description": "Optional text search and match navigation for Console",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@moyarich/console-core": "^0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@moyarich/console-core": "0.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "react": "^19.2.7",
    "@types/react": "^19.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/console.git",
    "directory": "packages/addons/search"
  },
  "bugs": {
    "url": "https://github.com/moyarich/console/issues"
  },
  "homepage": "https://github.com/moyarich/console#readme",
  "keywords": [
    "console",
    "addon",
    "search"
  ],
  "sideEffects": [
    "./src/components/ConsoleSearchControls/ConsoleSearchControls.css",
    "./src/components/ConsoleSearchHighlight/ConsoleSearchHighlight.css"
  ]
}
